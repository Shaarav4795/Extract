{
  "manifest_version": 3,
  "name": "Extract - Colour Picker",
  "version": "1.0.0",
  "description": "A colour picker for Google Chrome",
  "minimum_chrome_version": "95",
  "action": {
    "default_popup": "index.html",
    "default_title": "Pick a colour with Extract",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
